<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <input>

        <net-file value="network.net.xml"/>

        <route-files value="routes.rou.xml"/>

    </input>

    <time>

        <begin value="0"/>

        <end value="3600"/>

        <step-length value="1"/>

    </time>

    <processing>

        <collision.action value="warn"/>

        <time-to-teleport value="-1"/>

    </processing>

    <report>

        <verbose value="true"/>

        <no-step-log value="true"/>

    </report>

    <gui_only>

        <start value="true"/>

    </gui_only>

</configuration>